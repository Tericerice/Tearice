{
  "name": "droppoint-fileshelf",
  "productName": "DropPoint FileShelf",
  "version": "0.1.0",
  "description": "A desktop file shelf with one independently draggable card per item",
  "main": "./src/App.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --publish never",
    "release": "electron-builder --publish always",
    "test": "playwright test",
    "visual:qa": "node test/capture-visual-qa.js"
  },
  "keywords": [
    "electron",
    "drag-and-drop",
    "file-shelf",
    "desktop-utility"
  ],
  "author": {
    "name": "DropPoint contributors"
  },
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/tonyzaca7755963/Tearice/tree/main/DropPoint-FileShelf",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tonyzaca7755963/Tearice.git",
    "directory": "DropPoint-FileShelf"
  },
  "bugs": {
    "url": "https://github.com/tonyzaca7755963/Tearice/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "build": {
    "appId": "local.droppoint.fileshelf",
    "productName": "DropPoint FileShelf",
    "artifactName": "DropPoint-FileShelf-${version}-${os}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.utilities"
    },
    "dmg": {
      "icon": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "tar.gz",
        "rpm"
      ],
      "category": "Utility"
    },
    "win": {
      "target": [
        "zip",
        "nsis"
      ]
    }
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9",
    "preline": "^1.1.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/forms": "^0.5.3",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^3.1.8"
  },
  "optionalDependencies": {
    "dmg-license": "^1.0.11"
  }
}
